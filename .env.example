# ============================================================
# Kanboard Configuration for Railway
# ============================================================
# Copy this file to .env and adjust values as needed.
# Kanboard uses SQLite by default — no additional database required.
# For MySQL or PostgreSQL, uncomment and configure the DB_* vars below.

# Application Port (Railway sets this automatically)
PORT=80

# ============================================================
# Database Configuration
# ============================================================
# Default: SQLite (no configuration needed — data persists via volume)
# For production with multiple replicas, use MySQL or PostgreSQL.

# Database driver: sqlite, mysql, postgres
DB_DRIVER=sqlite

# MySQL / PostgreSQL connection settings (required if DB_DRIVER is not sqlite)
# DB_HOSTNAME=
# DB_NAME=kanboard
# DB_USERNAME=
# DB_PASSWORD=
# DB_PORT=

# ============================================================
# Email Configuration (optional)
# ============================================================
# MAIL_FROM=kanboard@example.com
# MAIL_TRANSPORT=smtp
# MAIL_SMTP_HOSTNAME=smtp.example.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USERNAME=
# MAIL_SMTP_PASSWORD=
# MAIL_SMTP_ENCRYPTION=tls
