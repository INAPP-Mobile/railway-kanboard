# =============================================================================
# Kanboard — Railway Template
# =============================================================================
# Only the variables a user needs to consider at deploy time are listed below.
# DB configuration (MySQL/Postgres), SMTP settings, and debug mode are
# documented in the README — add them from the Railway Variables tab if needed.
#
# Run `python3 scripts/set-service-vars.py <project-id> <env-id> .env.example`
# to push these to Railway, then re-generate and re-publish the template.
# =============================================================================

# Enable the plugin installer from the Administration > Plugins menu. [Optional]
# Set to true to browse and install plugins from the Kanboard plugin directory.
PLUGIN_INSTALLER=false

# From address used for email notifications (task assignments, due date [Optional]
# reminders, project activity). Leave as-is for localhost-only deployments;
# change to a real address if you configure SMTP.
MAIL_FROM=notifications@localhost
